{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pdf_text_router.py"
            ],
            "timeout": 60,
            "statusMessage": "Checking the PDF for a text layer..."
          }
        ]
      }
    ]
  }
}
